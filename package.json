{
  "name": "saucedemo-qa",
  "version": "1.0.0",
  "description": "Automatizacion Playwright (POM) del carrito de https://www.saucedemo.com",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:carrito": "playwright test --grep @carrito",
    "test:navegacion": "playwright test --grep @navegacion",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
